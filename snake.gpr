project Snake is

   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj/native";
   for Exec_Dir use "obj/native";
   for Main use ("smoke.adb");
   for Excluded_Source_Files use
     ("snake-api.ads", "snake-api.adb", "last_chance_handler.ads", "last_chance_handler.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-static");
   end Binder;

end Snake;
